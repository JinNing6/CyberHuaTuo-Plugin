{
  "description": "CyberHuaTuo reviews destructive shell actions before execution.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_guard.py\"",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}\\hooks\\pre_tool_guard.py\"",
            "timeout": 5,
            "statusMessage": "CyberHuaTuo is reviewing the proposed command"
          }
        ]
      }
    ]
  }
}

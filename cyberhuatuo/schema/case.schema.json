{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JinNing6/CyberHuaTuo-Plugin/schema/case.schema.json",
  "title": "CyberHuaTuo Case Schema",
  "description": "Schema for validating CyberHuaTuo case file YAML front matter",
  "type": "object",
  "required": [
    "id",
    "title",
    "title_en",
    "framework",
    "severity",
    "complexity",
    "created_at",
    "contributors"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+-[a-z0-9-]+-[0-9]{3,}$",
      "description": "Unique case identifier, format: <framework>-<category>-<name>-<number>"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "description": "Chinese title"
    },
    "title_en": {
      "type": "string",
      "minLength": 5,
      "description": "English title"
    },
    "framework": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_-]{0,63}$"
    },
    "framework_version": {
      "type": "string",
      "description": "Affected framework version range"
    },
    "language": {
      "type": "string",
      "description": "Programming language, e.g. python, typescript"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Descriptive tags for the case"
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "moderate", "complex", "extreme"]
    },
    "quality_status": {
      "type": "string",
      "enum": ["draft", "reviewed", "gold"],
      "description": "Explicit review state. Missing legacy values are treated as draft by runtime retrieval."
    },
    "disease_category": {
      "type": "string",
      "enum": [
        "dependency-and-version",
        "runtime-and-lifecycle",
        "data-and-serialization",
        "api-and-schema",
        "storage-and-filesystem",
        "database-and-migration",
        "security-and-credentials",
        "agent-and-tooling",
        "network-and-integration",
        "performance-and-resource",
        "ui-and-interaction",
        "system-configuration",
        "other"
      ],
      "description": "Stable disease department key used by CLI, MCP, and indexes."
    },
    "case_origin": {
      "type": "string",
      "enum": [
        "maintainer-incident",
        "community-submission",
        "upstream-documentation",
        "automated-regression"
      ]
    },
    "origin_skill": {
      "type": "string",
      "minLength": 3
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "match_signatures": {
      "type": "array",
      "items": { "type": "string", "minLength": 8 },
      "minItems": 1,
      "uniqueItems": true
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "verification_method": {
      "type": "string",
      "minLength": 3
    },
    "evidence_urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true
    },
    "environment": {
      "type": "object",
      "properties": {
        "python_version": { "type": "string" },
        "os": { "type": "string" }
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Creation date in YYYY-MM-DD format"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["github"],
        "properties": {
          "github": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "source_url": {
      "type": "string"
    },
    "related_cases": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "quality_status": { "enum": ["reviewed", "gold"] } },
        "required": ["quality_status"]
      },
      "then": {
        "required": ["source_url", "reviewed_at", "reviewed_by", "match_signatures"],
        "properties": { "source_url": { "type": "string", "format": "uri", "minLength": 8 } }
      }
    },
    {
      "if": {
        "properties": { "quality_status": { "const": "gold" } },
        "required": ["quality_status"]
      },
      "then": {
        "required": ["verified_at", "verification_method", "evidence_urls"],
        "properties": { "evidence_urls": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "case_origin": { "const": "maintainer-incident" } },
        "required": ["case_origin"]
      },
      "then": {
        "required": ["origin_skill", "reviewed_at"]
      }
    }
  ],
  "additionalProperties": true
}
